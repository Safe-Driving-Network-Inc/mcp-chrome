# Chrome Extension Private Key
# Copy this file to .env and replace with your actual private key
# This key is used for Chrome extension packaging and should be kept secure
CHROME_EXTENSION_KEY=YOUR_PRIVATE_KEY_HERE

# ─── Kareenos Browser Channel ───────────────────────────────────────────────
# All VITE_-prefixed; copy to .env.local for local builds. Per white-label brand,
# override at build time. Runtime overrides also exist via chrome.storage.local
# (kareenos_server_url, kareenos_connect_url) for testing without a rebuild.

# wss/ws endpoint of the browser_channel_server. MUST include the /browser-channel
# path and the server port (config.browserChannelConfig.port, default 8092). This
# is the BACKEND host, which is not the same host as the connect page below —
# kareenos.com serves only the static SPA.
VITE_BROWSER_CHANNEL_URL=wss://ap4.sdnvision.services:8092/browser-channel

# Origin(s) of the Kareenos connect page that may sign the extension in
# (content-script relay + externally_connectable). Comma-separated match patterns.
# MUST contain the origin of VITE_KAREENOS_CONNECT_URL or the connect page's
# token never reaches the extension and "Connect this browser" appears to do
# nothing. www. is a distinct origin and needs its own pattern.
VITE_KAREENOS_MATCHES=https://kareenos.com/*,https://www.kareenos.com/*,https://ap4.sdnvision.services/*,http://localhost/*

# The Kareenos connect page the popup's "Sign in" opens (it calls
# /superos.browser_channel_link_start; lives in the Kareenos frontend).
VITE_KAREENOS_CONNECT_URL=https://kareenos.com/kareenos/connectextension
